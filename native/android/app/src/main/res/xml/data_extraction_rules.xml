<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the travel log goes into Android's backup and moves with you to a new phone.
     Photos are not included here; the Excel backup can carry them. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="asfari-state.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="asfari-state.json" />
    </device-transfer>
</data-extraction-rules>
